# Copy to .env.local and fill in. Never commit secrets.
# FastAPI backend (Pet runtime, mind, activity engine, media engine, ...)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (Auth + Postgres). Leave unset to run in DEMO MODE
# (app works fully against the FastAPI backend, banner shown).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
